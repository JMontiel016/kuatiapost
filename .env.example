# Configuración del administrador. No se expone en el navegador.
# Ollama local: ollama pull llama3.2; luego ollama serve si no está iniciado.
LLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
LLAMA_MODEL=llama3.2
LLAMA_API_KEY=

# Almacenamiento persistente en Vercel. La integración Turso configura estas variables.
# Para SQLite local, dejá ambas vacías.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
